{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@bac/ui": ["packages/ui/src/index.ts"],
      "@bac/design-tokens": ["packages/design-tokens/src/index.ts"],
      "@bac/tokens": ["packages/design-tokens/src/index.ts"],
      "@bac/api-clients": ["packages/api-clients/src/index.ts"],
      "@bac/auth": ["packages/auth/src/index.ts"],
      "@bac/config": ["packages/config/src/index.ts"],
      "@bac/observability": ["packages/observability/src/index.ts"],
      "@bac/testing": ["packages/testing/src/index.tsx"]
    }
  }
}
