NEXT_PUBLIC_BAC_ENV=development
NEXT_PUBLIC_BAC_APP_NAME=BAC Frontend Experience
NEXT_PUBLIC_BAC_ENABLE_MOCK_API=true
NEXT_PUBLIC_BAC_DEFAULT_REGION=ng
NEXT_PUBLIC_BAC_PROXY_THROUGH_BFF=true
NEXT_PUBLIC_BAC_AUTH_BASE_URL=https://auth.example.com/application/o/bac-frontend/
NEXT_PUBLIC_BAC_AUTH_CLIENT_ID=bac-frontend-web
NEXT_PUBLIC_BAC_AUTH_ISSUER_URL=https://auth.example.com/application/o/bac-frontend/
NEXT_PUBLIC_BAC_AUTH_AUTHORIZE_URL=https://auth.example.com/application/o/authorize/
NEXT_PUBLIC_BAC_AUTH_TOKEN_URL=https://auth.example.com/application/o/token/
NEXT_PUBLIC_BAC_AUTH_LOGOUT_URL=https://auth.example.com/application/o/logout/
NEXT_PUBLIC_BAC_FEATURE_GRAPHIQL=true
NEXT_PUBLIC_BAC_FEATURE_SWAGGER=true
NEXT_PUBLIC_BAC_FEATURE_AUDIT_TRAIL=true
NEXT_PUBLIC_BAC_FEATURE_LIVE_SUBSCRIPTIONS=true
NEXT_PUBLIC_BAC_FEATURE_OIDC_LOGIN=true
NEXT_PUBLIC_BAC_FEATURE_PREVIEW_DEPLOYS=true
NEXT_PUBLIC_BAC_SDX_API_URL=http://localhost:8080
NEXT_PUBLIC_BAC_PLATFORM_API_URL=http://localhost:8081
NEXT_PUBLIC_BAC_HASURA_URL=http://localhost:8082/v1/graphql
NEXT_PUBLIC_BAC_SWAGGER_URL=http://localhost:8080/api/openapi/openapi.json
NEXT_PUBLIC_BAC_OTEL_COLLECTOR_URL=http://localhost:4318/v1/traces
BAC_SESSION_SECRET=development-session-secret-change-me
BAC_AUTH_CLIENT_SECRET=replace-me-for-confidential-clients
# For `software-factory-web` use port 3000. For `platform-automation-web` use port 3001.
BAC_AUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
