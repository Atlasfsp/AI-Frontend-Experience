{
  "extends": "../../packages/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@bac/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@bac/design-tokens": [
        "../../packages/design-tokens/src/index.ts"
      ],
      "@bac/api-clients": [
        "../../packages/api-clients/src/index.ts"
      ],
      "@bac/auth": [
        "../../packages/auth/src/index.ts"
      ],
      "@bac/config": [
        "../../packages/config/src/index.ts"
      ],
      "@bac/config/cdn": [
        "../../packages/config/src/cdn.ts"
      ],
      "@bac/observability": [
        "../../packages/observability/src/index.ts"
      ],
      "@bac/observability/react": [
        "../../packages/observability/src/react.ts"
      ],
      "@bac/observability/nextjs-server": [
        "../../packages/observability/src/nextjs-server.ts"
      ]
    },
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
